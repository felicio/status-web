{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@payload-config": [
        "./payload.config.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "eslint.config.mjs",
    "scripts",
    "src/migrations",
    "src/**/__tests__",
    "src/collections/BuilderHub.ts",
    "src/collections/BuilderResources.ts",
    "src/collections/Circles.ts",
    "src/collections/Ideas.ts",
    "src/collections/Rfps.ts"
  ]
}
